          "expr": "histogram_quantile(0.95, sum by (le) (last_over_time(gen_ai_client_operation_duration_seconds_bucket{service_name=\"$service\", service_instance_id=~\"$run\", gen_ai_provider_name=~\"$provider\"}[$__range])))",
